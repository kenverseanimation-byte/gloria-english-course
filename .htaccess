# Security headers for Apache / cPanel hosting (the same rules as _headers, which Netlify and Cloudflare Pages read).
# Needs mod_headers, which almost every cPanel host has; without it these lines are skipped, not an error.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # only over HTTPS: tells browsers to always use the secure address from now on
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# compress text files on the way out (three.js shrinks from about 670 KB to 170 KB)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# do not list folder contents
Options -Indexes
